# Public presentation template: external keys are intentionally empty.
# Copy to .env only after reviewing SECURITY.md. Do not commit your .env.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_STABILITY=0.35
ELEVENLABS_SIMILARITY=0.80
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEAKER_BOOST=true
# ===== Голос NOVA AI (Fish.audio, необязательно) =====
# Свой голос: fish.audio → Reference Models → скопировать ID.
# Без этой пары значений озвучка пойдёт через ElevenLabs или голос macOS.
# TTS_PROVIDER: auto (Fish если ключ есть, иначе ElevenLabs) | fish | elevenlabs
TTS_PROVIDER=auto
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free
JARVIS_INPUT_MODE=text
# ===== Микрофон и распознавание речи (STT) =====
# Распознавание работает ЛОКАЛЬНО на движке Vosk (модель в models/vosk*),
# поэтому голос не зависит от интернета и не ломается вне региона Google.
# STT_MIC_INDEX: индекс входного устройства (можно посмотреть в
#   Системной информации → Аудио). Пусто = NOVA AI сам выбирает микрофон,
#   с которого реально идёт звук (игнорирует «молчащие» Continuity-входы).
# STT_LANGUAGE: язык распознавания (используется только запасным Google-путём).
# STT_WAKE_WORD: слово-будильник «Джарвис» перед командой (true/false).
# STT_ENGINE: auto (локальный Vosk, Google как запасной) | vosk | google.
# STT_VOSK_MODEL: путь к папке модели Vosk. Пусто = ищем models/vosk*.
STT_MIC_INDEX=
STT_LANGUAGE=ru-RU
STT_WAKE_WORD=true
STT_ENGINE=auto
STT_VOSK_MODEL=
# ===== AI =====
# «Неограниченно и онлайн»: цепочка провайдеров с авто-фейловером.
# Если у одного кончилась квота/ошибка — запрос уходит следующему.
# AI_PROVIDER: auto (по умолчанию, все с ключами) | groq | gemini |
#              cerebras | openrouter | nim | ollama | custom
AI_PROVIDER=auto
# --- Бесплатные онлайн-провайдеры (достаточно хотя бы одного ключа) ---
# Groq: https://console.groq.com/keys (~30 req/мин бесплатно)
GROQ_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey (большой дневной лимит)
GEMINI_API_KEY=
# Cerebras: https://cloud.cerebras.ai (~1 млн токенов/день)
CEREBRAS_API_KEY=
# OpenRouter: https://openrouter.ai/keys (~50 req/день на бесплатных моделях)
OPENROUTER_API_KEY=
# NVIDIA NIM: https://build.nvidia.com (бесплатный кредит ~40 req/мин)
NIM_API_KEY=
# --- Локальная Ollama: безлимитно, без ключа, работает даже без интернета ---
# Установка: https://ollama.com/download → ollama pull qwen2.5:7b
# (сервер автоматически подхватывается, когда запущен)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# --- Legacy: ключ применялся только к Groq (AI_API_KEY) либо к своему
# эндпоинту (AI_BASE_URL + AI_MODEL + AI_API_KEY = режим custom) ---
# AI_PROVIDER=custom
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
# JSON-режим для Groq/Cerebras: true; для Gemini/OpenRouter/NIM/Ollama: false
AI_JSON_MODE=true

# ===== Основной AI-провайдер: FreeLLM API =====
# Локальный роутер (http://localhost:3001/v1), запускается через Colima +
# Docker (сценарий ~/freellmapi). Без ограничений, без ключей, без интернета.
# Запуск: ~/freellmapi → docker compose up -d
# Ключ генерируется автоматически и хранится в ~/freellmapi/.env.
# FreeLLM — ПРИОРИТЕТНЫЙ провайдер. При отсутствии ключа NOVA AI переходит
# на следующего провайдера в цепочке (Groq → Gemini → ...).
FREELLM_API_KEY=
FREELLM_BASE_URL=http://localhost:3001
FREELLM_MODEL=auto
# ===== AI: живая, разнообразная речь и «гипергенерация» =====
# Температура (0.7–1.0 = живая речь; 0.2 = роботизированные повторы).
# Джиттер добавляет лёгкое различие между похожими запросами.
AI_TEMPERATURE=0.8
AI_TEMPERATURE_JITTER=0.1
AI_TOP_P=0.95
# Штрафы за повторяющиеся слова (Groq/Cerebras/OpenRouter/NIM/custom).
AI_PENALTIES=true
AI_FREQUENCY_PENALTY=0.4
AI_PRESENCE_PENALTY=0.3
# Гипергенерация: NOVA AI генерирует несколько вариантов ответа и выбирает
# лучший (живость + отсутствие повторов). CANDIDATES = число вариантов.
AI_HYPERGEN=true
AI_HYPERGEN_CANDIDATES=2
# Гипергенерация применяется к коротким/средним голосовым ответам.
AI_HYPERGEN_MIN_LEN=40
AI_HYPERGEN_MAX_LEN=240

# ===== Веб-поиск и самообучение (безопасно, всё локально) =====
# Поиск идёт по цепочке: DuckDuckGo → Wikipedia API → Google News RSS
# (без ключей; при недоступности одного источника автоматически следующий).
# Знания и идеи сохраняются только в data/self_learning.json.
JARVIS_LEARN_ENABLED=false
# Как часто фоновый поток оглядывается на расписание (секунды).
JARVIS_LEARN_TICK_SEC=3600
# Через сколько часов после прошлой проверки искать новые идеи улучшений.
JARVIS_LEARN_IMPROVE_HOURS=24
# Минимальная пауза между вежливыми предложениями «у меня есть идеи» (часы).
JARVIS_LEARN_SUGGEST_COOLDOWN_HOURS=24
# Не искать улучшения первые N минут после запуска.
JARVIS_LEARN_START_DELAY_MIN=15
# Локальный файл знаний (не трогать без необходимости).
JARVIS_LEARNING_FILE=data/self_learning.json

# ===== Собственный VPN-сервис NOVA AI (безопасный сетевой слой) =====
# Перед приветствием NOVA AI сам проверяет сеть и подключает лучший канал.
# Каналы-«серверы»: прямое подключение → системный прокси macOS → свои прокси.
# ВАЖНО: VPN действует ТОЛЬКО на NOVA AI — туннель применяется через переменные
# окружения внутри СОБСТВЕННОГО процесса NOVA AI (requests читает их во всех
# AI-вызовах); система и другие приложения не видят его, их трафик идёт как раньше.
# Ничего не устанавливает, sudo не нужен, системные сетевые интерфейсы не меняются.
JARVIS_VPN_ENABLED=false
# Общий бюджет подключения ДО приветствия (секунды). Не успели — локальный режим.
JARVIS_VPN_CONNECT_TIMEOUT=12
# Какой адрес «щупать» при проверке канала (эндпоинт AI).
JARVIS_VPN_PROBE_URL=https://generativelanguage.googleapis.com
# Таймаут одной пробы канала (секунды).
JARVIS_VPN_PROBE_TIMEOUT=4
# Файл со списком «серверов» NOVA AI VPN (можно добавлять свои прокси).
JARVIS_VPN_SERVERS_FILE=data/vpn_servers.json
# Свой прокси (http/socks5), например: http://127.0.0.1:10809
JARVIS_VPN_PROXY=
# Дополнительные каналы-прокси (JSON), например:
#   [{"name":"Мой прокси","kind":"proxy","url":"http://127.0.0.1:3128"}]
JARVIS_VPN_SERVERS=
# Как часто монитор перепроверяет сеть и автофейловер (секунды).
# Чем меньше — тем быстрее NOVA AI откатывается на рабочий канал при
# переключении/выключении вашего системного VPN-клиента.
JARVIS_VPN_MONITOR_TICK=30
# ===== Собственный VPN: авто-подбор канала для онлайн-AI (страны вне СНГ) =====
# Google гео-блокирует Gemini из стран СНГ (400 «location is not supported»,
# а также 403/404). Когда эта опция включена, NOVA AI САМ находит рабочий
# HTTP(S)-прокси в стране вне СНГ, проверяет канал реальным запросом к Google
# и применяет до приветствия — без вашего участия. Ключи AI едут по TLS
# к провайдеру, поэтому публичные прокси видят только CONNECT, не содержимое.
# Проверка идёт по двум уровням: дешёвый запрос списка моделей (не расходует
# дневную квоту генерации) и затем реальная AI-проба выбранного канала.
JARVIS_VPN_GEO_AUTO=false
# Страны, каналы которых НЕ использовать (по умолчанию страны СНГ).
JARVIS_VPN_GEO_EXCLUDE=RU,BY,KZ,AM,AZ,MD,KG,TJ,TM,UZ,UA,GE
# Сколько прокси пробуем за один поиск и сколько параллельно (скорость).
JARVIS_VPN_GEO_MAX_PROXIES=60
JARVIS_VPN_GEO_WORKERS=16
# Таймаут одной AI-пробы через прокси-кандидата (секунды).
JARVIS_VPN_GEO_PROBE_TIMEOUT=6
# Общий бюджет поиска канала на старте (секунды).
JARVIS_VPN_GEO_TIMEOUT=20
# Пока активный geo-канал моложе — не пере-проверяем AI на каждом тике.
JARVIS_VPN_GEO_VERIFY_INTERVAL=120
# Пере-искать канал заново не чаще, чем раз в N секунд (если текущий жив).
JARVIS_VPN_GEO_REFRESH=1800
# Где кэшировать последний рабочий канал (быстрый старт).
JARVIS_VPN_GEO_CACHE_FILE=data/vpn_geo_channel.json
# Источники публичных списков прокси для авто-подбора (через запятую).
# Можно добавить свои: например свежий список вашего регионального провайдера.
JARVIS_VPN_GEO_SOURCES=https://api.proxyscrape.com/v4/free-proxy-list/get?request=display_proxies&protocol=http&proxy_format=ipport&format=text&timeout=5000&country=all,https://proxylist.geonode.com/api/proxy-list?limit=150&page=1&sort_by=lastChecked&sort_type=desc&protocols=http,https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/http.txt,https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/http.txt,https://raw.githubusercontent.com/proxifly/free-proxy-list/main/proxies/all/data.txt
# ===== AI =====
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# ===== Telegram-бот (автоответы от имени владельца) =====
# Создайте бота: телеграм-канал @BotFather → /newbot, затем вставьте токен.
# Токен секретный — не передавайте третьим лицам.
TG_BOT_TOKEN=
# Разрешить NOVA AI подключаться к боту и слушать входящие (true/false)
TG_BOT_ENABLED=false
# Права бота (подпункты доступа в настройках)
TG_BOT_READ=false
TG_BOT_WRITE=false
TG_BOT_AUTOREPLY=false
# Ваш Telegram user id (бот игнорирует ваши сообщения). Узнать: @userinfobot
TG_BOT_OWNER_ID=0
# Имя владельца — для приветствия бота. Впишите своё (или оставьте пустым).
TG_BOT_OWNER_NAME=
# Разрешённые чаты: id через запятую.
# ВАЖНО: пусто = бот молчит, а не отвечает всем. Бот пишет от вашего имени,
# поэтому «отвечать каждому, кто нашёл бота» — не то же самое, что «отвечать
# вам». Перечислите нужные чаты.
TG_BOT_DIALOGS=
# Отвечать всем личным чатам без перечисления. По умолчанию false.
# Включайте, только если осознанно готовы, что бот пишет от вашего имени
# каждому, кто ему написал.
TG_BOT_ALLOW_ALL_DIALOGS=false
# Приветствие: {owner} подставляется автоматически
TG_BOT_GREETING=Привет! Я Jar'vis, AI-ассистент {owner}. {owner} сейчас занят, так что буду отвечать за него. Чем могу помочь?
JARVIS_PERSONA=sol
# ===== Безопасное наблюдение за экраном и профиль пользователя =====
# NOVA AI видит ТОЛЬКО метаданные: какое приложение на переднем плане, какие
# программы открыты, активную вкладку Chrome. Содержимое окон НЕ читается,
# клавиши НЕ записываются. Вся статистика хранится локально в data/.
JARVIS_SCREEN_AWARENESS=false
# Скриншоты ВЫКЛЮЧЕНЫ по умолчанию (безопасно). Для включения нужны
# JARVIS_SCREEN_CAPTURE=true и разрешение macOS «Запись экрана» для Terminal.
# Скриншоты сохраняются только локально в data/screenshots, в сеть не уходят.
JARVIS_SCREEN_CAPTURE=false
# Предложение при старте в интересах пользователя
# (для этого пользователя: начать работу в OpenCode и VS Code).
JARVIS_STARTUP_SUGGEST=false
# ===== Распорядок дня (вежливые подсказки по времени) =====
JARVIS_ROUTINE_ENABLED=false
# Минут непрерывно в развлечениях — после этого NOVA AI предложит вернуться
# к работе (45 по умолчанию).
JARVIS_ROUTINE_ENTERTAINMENT_MIN=45
# Сколько часов работы в день считать нормой — после этого NOVA AI предложит
# отдохнуть и задаст вопрос (8 часов по умолчанию).
JARVIS_ROUTINE_MAX_WORK_HOURS=8
# Пауза между подсказками одного типа (минуты), тик наблюдения (секунды)
# и спокойная пауза после запуска (минуты).
JARVIS_ROUTINE_COOLDOWN_MIN=30
JARVIS_ROUTINE_TICK_SEC=60
JARVIS_ROUTINE_START_DELAY_MIN=5
# Файлы профиля и статистики (локально, не трогать без необходимости)
JARVIS_USER_PROFILE=data/user_profile.json
JARVIS_USAGE_LOG=data/usage_log.json
# ===== Мастер-пароль =====
# Создаётся/удаляется во вкладке «Безопасность» панели настроек.
# Хранится только как PBKDF2-хэш в data/vault.json (в .env не пишется).
