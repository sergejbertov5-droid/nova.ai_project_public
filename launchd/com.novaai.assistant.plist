<?xml version="1.0" encoding="UTF-8"?>
<!--
    ШАБЛОН LaunchAgent. Не копируется в ~/Library/LaunchAgents как есть:
    start_nova_ai_hidden.sh подставляет вместо __PROJECT_DIR__ и __HOME__
    настоящие пути и только потом устанавливает агент.

    Прежде здесь лежал готовый plist с путём машины автора. Он молча
    уезжал к покупателю вместе с проектом, и агент указывал на
    несуществующую папку — NOVA AI не запускался при входе в систему.

    Тот же агент можно поставить вручную, заменив два маркера вручную
    либо запустив ./install_launchagent.sh, который собирает его сам.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nova_ai.assistant</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/launch_nova_ai_daemon.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/nova_ai-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/nova_ai-launchd-error.log</string>
    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:__PROJECT_DIR__/.venv/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
